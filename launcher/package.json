{
  "name": "frigieregameslauncher",
  "productName": "FRIGIEREGAMES LAUNCHER",
  "version": "1.1.0",
  "description": "Launcher officiel Frigiere.games",
  "author": "Thomas F.",
  "main": "main.cjs",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "games.frigiere.launcher",
    "files": ["main.cjs", "preload.cjs", "projects.cjs", "intro.html", "build/*.png", "build/*.ico"],
    "win": { "target": "nsis", "icon": "build/icon.ico", "artifactName": "frigieregameslauncher.exe" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FRIGIEREGAMES LAUNCHER",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
